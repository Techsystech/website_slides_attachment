<templates>
    <t t-name="website.slides.fullscreen.content.video">
        <div class="ratio h-100">
            <t t-set="src" t-value="'/website_slides_attachment/download/' + widget._slideValue.id + '/filename=' + encodeURIComponent((widget._slideValue.name || 'local-video') + '.mp4')"/>
            <video id="embeddedVideoViewer" class="o-FileViewer-view" controls="controls" preload="metadata">
                <source t-att-src="src" type="video/mp4"/>
                Your browser does not support the video tag.
            </video>
        </div>
    </t>
</templates>
