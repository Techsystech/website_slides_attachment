<odoo>
  <data>
    <record model="ir.ui.view" id="website_slides_attachment.form">
      <field name="name">website_slides_attachment_form</field>
      <field name="model">slide.slide</field>
      <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='slide_category']" position="after">
          <field name="is_local_video" invisible="slide_category != 'video'"/>
        </xpath>
        <xpath expr="//field[@name='document_binary_content']" position="after">
          <field name="video_binary_content" widget="large_file_upload_widget" options="{'accepted_file_extensions': '.mp4'}" invisible="slide_category != 'video' or is_local_video == False"/>
        </xpath>
        <xpath expr="//field[@name='video_url']" position="attributes">
          <attribute name="invisible">slide_category != 'video' and source_type != 'external' or is_local_video == True</attribute>
        </xpath>
      </field>
    </record>

    <template id="slide_content_detailed_local_video" inherit_id="website_slides.slide_content_detailed" name="Slide: Detailed Local Video Playback">
      <xpath expr="//div[@t-if=&quot;slide.slide_category == 'video'&quot;]" position="replace">
        <div t-if="slide.slide_category == 'video' and slide.video_source_type == 'local'" class="ratio ratio-16x9 embed-responsive-item mb8">
          <video class="o-FileViewer-view" controls="controls" preload="metadata">
            <source t-att-src="'/website_slides_attachment/download/%s' % slide.id" t-att-type="slide._get_local_video_attachment().mimetype or 'video/mp4'"/>
            Your browser does not support the video tag.
          </video>
        </div>
        <div t-elif="slide.slide_category == 'video'" class="ratio ratio-16x9 embed-responsive-item mb8">
          <t t-out="slide.embed_code"/>
        </div>
      </xpath>
    </template>
  </data>
</odoo>
