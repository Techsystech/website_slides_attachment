<odoo>
  <data>
    <record model="ir.ui.view" id="website_slides_attachment.form">
      <field name="name">website_slides_attachment_form</field>
      <field name="model">slide.slide</field>
      <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
      <field name="arch" type="xml">
        <!-- Replace video_url with a source-aware video section -->
        <xpath expr="//field[@name='video_url']" position="replace">
          <!-- Video Source selector shown for all video slides -->
          <field name="video_source_type"
                 string="Video Source"
                 invisible="slide_category != 'video'"
                 readonly="slide_category != 'video'"
                 required="slide_category == 'video'"/>
          <!-- URL field for external video sources (YouTube, Vimeo, Google Drive, Nextcloud) -->
          <field name="video_url"
                 invisible="slide_category != 'video' or video_source_type == 'local'"
                 readonly="slide_category != 'video' or video_source_type == 'local'"
                 required="slide_category == 'video' and video_source_type != 'local'"
                 placeholder='e.g "www.youtube.com/watch?v=ebBez6bcSEc"'
                 widget="url"/>
          <!-- Local video upload section -->
          <div class="o_local_video_upload"
               invisible="slide_category != 'video' or video_source_type != 'local'"
               colspan="2">
            <div class="card bg-light">
              <div class="card-body">
                <field name="video_binary_content"
                       widget="large_file_upload_widget"
                       options="{'accepted_file_extensions': '.mp4,.mov,.webm,.mkv'}"/>
              </div>
            </div>
          </div>
          <!-- Hidden fields needed by the upload widget for display -->
          <field name="video_attachment_name" invisible="1"/>
          <field name="video_attachment_mimetype" invisible="1"/>
          <field name="nextcloud_download_url" invisible="1"/>
        </xpath>
      </field>
    </record>

    <template id="slide_content_detailed_local_video" inherit_id="website_slides.slide_content_detailed" name="Slide: Detailed Local / Nextcloud Video Playback">
      <xpath expr="//div[@t-if=&quot;slide.slide_category == 'video'&quot;]" position="replace">
        <div t-if="slide.slide_category == 'video' and slide.video_source_type in ('local', 'nextcloud')" class="ratio ratio-16x9 embed-responsive-item mb8">
          <video class="o-FileViewer-view" controls="controls" preload="metadata">
            <t t-if="slide.video_source_type == 'local'">
              <source t-att-src="'/website_slides_attachment/download/%s' % slide.id" t-att-type="slide._get_local_video_attachment().mimetype or 'video/mp4'"/>
            </t>
            <t t-if="slide.video_source_type == 'nextcloud'">
              <source t-att-src="slide.nextcloud_download_url" type="video/mp4"/>
            </t>
            Your browser does not support the video tag.
          </video>
        </div>
        <div t-elif="slide.slide_category == 'video'" class="ratio ratio-16x9 embed-responsive-item mb8">
          <t t-out="slide.embed_code"/>
        </div>
      </xpath>
    </template>

    <template id="slide_fullscreen_sidebar_local_video" inherit_id="website_slides.slide_fullscreen_sidebar_category" name="Fullscreen Sidebar: Add local video / nextcloud flags">
      <xpath expr="//li[@t-att-data-id='slide.id']" position="attributes">
        <attribute name="t-att-data-is-local-video">slide.is_local_video</attribute>
        <attribute name="t-att-data-nextcloud-download-url">slide.nextcloud_download_url or False</attribute>
      </xpath>
    </template>
    <record id="action_migrate_legacy_local_videos" model="ir.actions.server">
      <field name="name">Migrate Legacy Local Videos</field>
      <field name="model_id" ref="website_slides.model_slide_slide"/>
      <field name="state">code</field>
      <field name="code">
result = env['slide.slide']._migrate_legacy_local_video_files()
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Legacy Video Migration',
        'message': 'Migrated: %(migrated)s, Skipped: %(skipped)s, Failed: %(failed)s' % result,
        'type': 'success' if result['failed'] == 0 else 'warning',
        'sticky': False,
    }
}
      </field>
    </record>
  </data>
</odoo>
